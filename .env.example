# ==============================================================================
# KONFIGURASI ENVIRONMENT - OPTIMASI & PREDIKSI BISNIS
# ==============================================================================
# Salin berkas ini ke `.env.local` untuk mengatur konfigurasi lingkungan Anda:
#   cp .env.example .env.local
#
# Catatan Keamanan:
# - Jangan pernah memasukkan API Key sungguhan ke dalam berkas .env.example ini.
# - Berkas `.env.local` sudah masuk dalam .gitignore sehingga aman dari commit Git.
# ==============================================================================

# Port Server Aplikasi (Default: 5000)
PORT=5000

# ------------------------------------------------------------------------------
# KONFIGURASI PENYEDIA AI (HOST-PROVIDED)
# ------------------------------------------------------------------------------
# Karena AI disediakan oleh sistem/host (bukan diinput oleh pengguna klien),
# Anda dapat memilih salah satu penyedia AI di bawah ini:
#
# Pilihan AI_PROVIDER:
# - local     : Mesin parser cerdas lokal (100% tanpa internet & tanpa API key)
# - gemini    : Google Gemini API (Sangat direkomendasikan, gratis di Google AI Studio)
# - groq      : Groq Cloud API (Super cepat, Llama 3.3 70B)
# - openai    : OpenAI API (GPT-4o / GPT-4o-mini)
# - deepseek  : DeepSeek API (DeepSeek-V3)
# - ollama    : Model LLM lokal via Ollama (contoh: Llama 3 / Qwen)
AI_PROVIDER=local

# ------------------------------------------------------------------------------
# KUNCI API (Isi sesuai AI_PROVIDER yang dipilih di atas)
# ------------------------------------------------------------------------------

# 1. Google Gemini (Dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq Cloud (Dapatkan di https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenAI (Dapatkan di https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 4. DeepSeek (Dapatkan di https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 5. Ollama Lokal (Jika menjalankan model LLM sendiri di mesin server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# KONFIGURASI TAMBAHAN APLIKASI
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Optimasi & Prediksi Bisnis"
NEXT_PUBLIC_APP_URL="http://localhost:5000"
